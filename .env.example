# Docker Compose: copy this file to .env in the repository root.
# Keep keys private. This is separate from ai-service/.env used outside Docker.
GOOGLE_API_KEY=
INTERNAL_API_KEY=replace-with-your-own-random-dev-key
LLM_PROVIDER=gemini
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
GEMINI_TIMEOUT_SECONDS=25
CHAT_PORT=8000
