# Khoá nội bộ: Spring Boot gửi kèm header X-Internal-Key. HÃY ĐỔI GIÁ TRỊ NÀY.
INTERNAL_API_KEY=doi-gia-tri-nay

# Gemini
GOOGLE_API_KEY=
# Dùng đúng tên model bạn đang chạy được trong rag_engine.py
GEMINI_CHAT_MODEL=gemini-3-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# gemini | mock  (mock = không gọi LLM, để thử nhanh luồng API/SSE)
LLM_PROVIDER=gemini

# Để trống = Qdrant chạy local trong thư mục data/qdrant_local (không cần Docker)
QDRANT_URL=
QDRANT_COLLECTION=donga_regulations

# Truy xuất
TOP_K=5
CANDIDATE_K=20
# 0 = tắt. Chỉnh sau khi chạy evaluation (xem README)
MIN_DENSE_SCORE=0
